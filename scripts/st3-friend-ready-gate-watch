#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

: "${ST3_BIN:?set ST3_BIN to the installed st3 executable}"
: "${ST_AGENT:?set ST_AGENT to the claimed st3 operator identity}"
: "${FABRIC_BIN:?set FABRIC_BIN to the installed Fabric executable}"
: "${ST3_FRIEND_READY_IDLE_START_UNIX:?set the first local Silber sample epoch}"
: "${ST3_FRIEND_READY_MESSAGE_START_UNIX:?set the complete-logging message monitor epoch}"

for value in "$ST3_FRIEND_READY_IDLE_START_UNIX" "$ST3_FRIEND_READY_MESSAGE_START_UNIX"; do
  [[ $value =~ ^[0-9]+$ ]] || { echo 'invalid gate start epoch' >&2; exit 2; }
done

MONITOR=agent/fleet/st3/delivery-soak-20260924/monitor
STATE_DIR=${ST3_GATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/st3/friend-ready-gates}
REPORT_DIR=$(/usr/bin/dirname "$0")
IDLE_REPORT="$REPORT_DIR/st3-idle-soak-report"
MESSAGE_REPORT="$REPORT_DIR/st3-message-soak-report"
/bin/mkdir -p "$STATE_DIR"
state="$STATE_DIR/state.json"
now=$(/bin/date -u +%s)

idle_output=
if idle_output=$(ST3_IDLE_REPORT_REMOTE=1 FABRIC_BIN="$FABRIC_BIN" "$IDLE_REPORT" 2>&1); then
  idle_report_pass=true
else
  idle_report_pass=false
fi
message_output=
if message_output=$("$MESSAGE_REPORT" 2>&1); then
  message_report_pass=true
else
  message_report_pass=false
fi

idle=waiting
message=waiting
if (( now >= ST3_FRIEND_READY_IDLE_START_UNIX + 86400 )); then
  if [[ $idle_report_pass == true ]]; then idle=pass; else idle=fail; fi
fi
if (( now >= ST3_FRIEND_READY_MESSAGE_START_UNIX + 259200 )); then
  if [[ $message_report_pass == true ]]; then message=pass; else message=fail; fi
fi

idle_summary=$(/usr/bin/jq -cr '{pass,hosts:[.hosts[]|{host,samples,errors,pid_count,quiet_cpu_median_pct,rss_growth_kib,pass}]}' \
  <<<"$idle_output" 2>/dev/null) || idle_summary='idle report unavailable or malformed'
if [[ $message_output == PASS:* || $message_output == FAIL:* ]]; then
  message_summary=${message_output//$'\n'/ }
  message_summary=${message_summary:0:500}
else
  message_summary='delivery report unavailable or malformed'
fi

old_idle=$(/usr/bin/jq -r '.idle_notice // ""' "$state" 2>/dev/null) || old_idle=
old_message=$(/usr/bin/jq -r '.message_notice // ""' "$state" 2>/dev/null) || old_message=
old_release=$(/usr/bin/jq -r '.release_notice // ""' "$state" 2>/dev/null) || old_release=
failures=0

send_notice() {
  local subject=$1 body=$2 response
  if response=$(/usr/bin/timeout -k 5s 30s "$ST3_BIN" conversations send "$ST_AGENT" \
    --from "$MONITOR" --subject "$subject" --body "$body" --json); then
    /usr/bin/jq -er '.subject' <<<"$response"
  else
    return 1
  fi
}

if [[ $idle != waiting && $idle != "$old_idle" ]]; then
  if receipt=$(send_notice "friend-ready idle gate: $idle" \
    "The 24-hour two-host idle gate is $idle. $idle_summary Keep the release held unless it passes; inspect the retained local samples on both hosts."); then
    old_idle=$idle
    /usr/bin/printf 'idle gate %s notified in %s\n' "$idle" "$receipt"
  else
    failures=1
  fi
fi
if [[ $message != waiting && $message != "$old_message" ]]; then
  if receipt=$(send_notice "friend-ready delivery gate: $message" \
    "The 72-hour bidirectional exact-receipt gate is $message. $message_summary Keep the release held unless it passes; inspect the retained monitor evidence."); then
    old_message=$message
    /usr/bin/printf 'delivery gate %s notified in %s\n' "$message" "$receipt"
  else
    failures=1
  fi
fi
if [[ $idle == pass && $message == pass ]]; then
  if [[ $old_release != pass ]]; then
    if receipt=$(send_notice 'friend-ready gates passed' \
      "Both the 24-hour idle and 72-hour exact-receipt gates pass on their default thresholds. Verify the claimed mission products and final release evidence before marking friend-ready. $idle_summary $message_summary"); then
      old_release=pass
      /usr/bin/printf 'combined gates notified in %s\n' "$receipt"
    else
      failures=1
    fi
  fi
else
  old_release=
fi

temporary=$(/usr/bin/mktemp "$STATE_DIR/state.XXXXXX")
/usr/bin/jq -nc --argjson checked_at "$now" --arg idle "$idle" --arg message "$message" \
  --arg idle_notice "$old_idle" --arg message_notice "$old_message" \
  --arg release_notice "$old_release" \
  '{checked_at:$checked_at,idle:$idle,message:$message,idle_notice:$idle_notice,
    message_notice:$message_notice,release_notice:$release_notice}' >"$temporary"
/usr/bin/mv "$temporary" "$state"
/usr/bin/printf 'friend-ready gates idle=%s delivery=%s\n' "$idle" "$message"
exit "$failures"
