subgraph {
  resource "release-review" {
    kind "human.review"
  }

  scope "release-example" retention="temporary" change-policy="agent" {
    plan "release" state="ready" {
      step "build" timeout="20m" {
        title "The build command passes"
        subgraph {
          exec "release-example/build/${PLAN_RUN}" {
            workspace "."
            command "cargo test --workspace"
            restart "never"
          }
        }
        judges {
          field "status" "exec/release-example/build/${PLAN_RUN}" "is" "exited"
          field "exit_code" "exec/release-example/build/${PLAN_RUN}" "is" 0
        }
      }

      step "approval" {
        title "A person approves the release"
        depends-on { step "build" completed }
        judges {
          field "decision" "resource/release-review" "is" "approved"
        }
      }

      step "cleanup" finally=#true {
        title "The temporary release scope is empty"
        subgraph {
          scope "release-example" { stop }
        }
        judges {
          empty "scope/release-example"
        }
      }
    }
  }
}
