version 2

  resource "release-review" {
    kind "human.review"
  }

  mission "release" state="ready" {
    completion { when "all-steps-exhausted" }
    goal "Complete mission release."
    step "build" timeout="20m" {
      title "The build command passes"
        exec "release-example/build" {
          workspace "."
          command "cargo test --workspace"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_MISSION_RUN}/release-example/build" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_MISSION_RUN}/release-example/build" "is" 0 }
    }

    step "approval" {
      title "A person approves the release"
      depends-on { step "build" completed }
      gate "condition-1" { field "decision" "resource/release-review" "is" "approved" }
    }
  }
