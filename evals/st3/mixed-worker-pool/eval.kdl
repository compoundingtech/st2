version 2

subgraph {
  scope "eval/mixed-worker-pool/${ST_PLAN_RUN}" retention="temporary" {
    plan "eval/mixed-worker-pool" state="ready" {
      agentless
      completion { when "all-steps-exhausted" }
      goal "A Codex agent and a Claude agent each claim one step from the same explicit worker pool."

      step "start-pool" timeout="10m" {
        title "Both pool agents are ready"
        subgraph {
          agent "pool.codex" {
            workspace "${ST_WORKSPACE}"
            harness "codex" {
              prompt "Use only st3 Small Talk. Drain and archive each message. Claim exactly one ready pool step. Write the requested marker with your ST_AGENT value. Complete that step. Do not claim another pool step."
              args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
            }
          }
          agent "pool.claude" {
            workspace "${ST_WORKSPACE}"
            under "agent/pool.codex" reason="share one bounded work pool"
            harness "claude" {
              dev-channels #true
              prompt "Use only st3 Small Talk. Drain and archive each message. Claim exactly one ready pool step. Write the requested marker with your ST_AGENT value. Complete that step. Do not claim another pool step."
              args "--permission-mode" "bypassPermissions"
            }
          }
        }
        gate "Codex is ready" { field "status" "agent/pool.codex" "is" "ready" }
        gate "Claude is ready" { field "status" "agent/pool.claude" "is" "ready" }
      }

      step "pool-a" timeout="10m" {
        title "One pool member writes marker A"
        goal "Write your exact ST_AGENT value to pool-a.txt. Complete this step after the file exists."
        available-to "agent/pool.codex"
        available-to "agent/pool.claude"
        depends-on { step "start-pool" completed }
        gate "marker A exists" { exec "test -f pool-a.txt"; host "local"; workspace "${ST_WORKSPACE}" }
      }

      step "pool-b" timeout="10m" {
        title "The other pool member writes marker B"
        goal "Write your exact ST_AGENT value to pool-b.txt. Complete this step after the file exists."
        available-to "agent/pool.codex"
        available-to "agent/pool.claude"
        depends-on { step "start-pool" completed }
        gate "marker B exists" { exec "test -f pool-b.txt"; host "local"; workspace "${ST_WORKSPACE}" }
      }

      step "held-out-gate" timeout="2m" {
        depends-on { step "pool-a" completed; step "pool-b" completed }
        gate "both harnesses completed distinct pool work" {
          exec "grep -Fxq agent/pool.codex pool-a.txt pool-b.txt && grep -Fxq agent/pool.claude pool-a.txt pool-b.txt && ! cmp -s pool-a.txt pool-b.txt"
          host "local"
          workspace "${ST_WORKSPACE}"
          time-limit "1m"
        }
      }

      finally {
        step "cleanup" {
          title "The temporary eval scope is empty"
          subgraph { scope "eval/mixed-worker-pool/${ST_PLAN_RUN}" { stop } }
          gate "condition" { empty "scope/eval/mixed-worker-pool/${ST_PLAN_RUN}" }
        }
      }
    }
  }
}
