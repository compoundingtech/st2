version 2

subgraph {
  scope "eval/context-resource-continuity/${ST_PLAN_RUN}" retention="temporary" {
    plan "eval/context-resource-continuity" state="ready" {
      goal "Complete plan eval/context-resource-continuity."
      step "contract" timeout="2m" {
        title "Context and resources survive two daemon restarts"
        subgraph {
          exec "eval/context-resource-continuity/contract/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}/fixture"
            cwd "${ST_WORKSPACE}/fixture"
            command "bash ./run.sh"
            restart "never"
          }
        }
        gate "condition-1" { field "status" "exec/eval/context-resource-continuity/contract/${ST_PLAN_RUN}" "is" "exited" }
        gate "condition-2" { field "exit_code" "exec/eval/context-resource-continuity/contract/${ST_PLAN_RUN}" "is" 0 }
      }
      step "gate" timeout="1m" {
        depends-on { step "contract" completed }
        gate "the exact context decision and resource remain readable" {
          exec "bash ./judge.sh"
          host "local"
          workspace "${ST_WORKSPACE}/fixture"
          time-limit "1m"
        }
      }
      step "cleanup" finally=#true {
        subgraph { scope "eval/context-resource-continuity/${ST_PLAN_RUN}" { stop } }
        gate "condition" { empty "scope/eval/context-resource-continuity/${ST_PLAN_RUN}" }
      }
    }
  }
}
