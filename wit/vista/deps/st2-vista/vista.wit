package compoundingtech:st2-vista@0.1.0;

interface vista {
  record artifact-request {
    slug: string,
    version: u64,
  }

  record source-snapshot {
    manifest-json: list<u8>,
    observed-at: string,
  }

  record source-observation {
    current: source-snapshot,
    previous: option<source-snapshot>,
  }

  variant exit-status {
    code(s32),
    signal(s32),
  }

  record command-failure {
    stderr: list<u8>,
    exit: exit-status,
  }

  variant artifact-response {
    ok(source-observation),
    command-failed(command-failure),
  }

  variant vista-error {
    denied,
    unavailable,
    resource-exhausted,
    deadline-exceeded,
    cancelled,
  }

  get: func(request: artifact-request) -> result<artifact-response, vista-error>;
  bind-snapshot: func(digest: list<u8>) -> result<_, vista-error>;
}
