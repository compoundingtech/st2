version 2

  plan "native-drivers" state="ready" {
    goal "Keep four native harnesses ready for work."
    step "start-harnesses" {
      agentless
        agent "native.claude" {
          workspace "."
          harness "claude" {
            dev-channels #true
            prompt "Wait for a native graph message."
          }
        }

        agent "native.codex" {
          workspace "."
          harness "codex" {
            prompt "Wait for a native graph message."
          }
        }

        agent "native.pi" {
          workspace "."
          harness "pi" {
            prompt "Wait for a native graph message."
          }
        }

        agent "native.opencode" {
          workspace "."
          harness "opencode" {
            prompt "Wait for a native graph message."
          }
        }
      gate "condition-1" { exists "agent/${ST_PLAN_RUN}/native.claude" }
      gate "condition-2" { exists "agent/${ST_PLAN_RUN}/native.codex" }
      gate "condition-3" { exists "agent/${ST_PLAN_RUN}/native.pi" }
      gate "condition-4" { exists "agent/${ST_PLAN_RUN}/native.opencode" }
    }
  }
