version 2

subgraph {
  plan "eval/license-mit" state="ready" {
    completion { when "all-steps-exhausted" }
    goal "Complete plan eval/license-mit."
    step "team" timeout="20m" {
      agentless
      title "The eval team is running"
      subgraph {
        agent "mix.sup" {
          workspace "${ST_WORKSPACE}/sup"
          harness "claude" {
            prompt "Read CLAUDE.md and handle st3 graph messages."
            args "--permission-mode" "bypassPermissions"
          }
          restart "never"
        }
        agent "mix.worker" {
          workspace "${ST_WORKSPACE}/worker"
          under "mix.sup" reason="the supervisor coordinates the license change"
          harness "claude" {
            prompt "Read CLAUDE.md and handle st3 graph messages."
            args "--permission-mode" "auto"
          }
          restart "never"
        }
      }
      gate "condition-1" { exists "agent/${ST_PLAN_RUN}/mix.sup" }
      gate "condition-2" { exists "agent/${ST_PLAN_RUN}/mix.worker" }
    }

    step "change-license" timeout="20m" {
      assigned-to "agent/${ST_PLAN_RUN}/mix.worker"
      title "The worker completes the license change"
      goal "Install the MIT license and report the commit to the supervisor."
      depends-on { step "team" completed }
      gate "LICENSE is real MIT" {
        exec "grep -F 'Permission is hereby granted' worker/LICENSE"
        host "local"
        workspace "${ST_WORKSPACE}"
        time-limit "120s"
      }
    }

    step "held-out-gates" timeout="20m" {
      agentless
      title "All held-out gates pass"
      depends-on { step "change-license" completed }
      gate "The confirmation contains evidence" type="llm" {
        model "gpt-5.6-sol"
        host "local"
        workspace "${ST_WORKSPACE}"
        tools "shell" "git"
        token-budget 8192
        time-limit "120s"
        prompt "Check that the completion message cites the commit and test evidence."
      }
    }
  }
}
