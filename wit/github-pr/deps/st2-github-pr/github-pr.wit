package compoundingtech:st2-github-pr@0.1.0;

interface github-pr {
  record pull-request-request {
    owner: string,
    repo: string,
    number: u64,
  }

  record source-snapshot {
    graphql-data: list<u8>,
    observed-at: string,
  }

  record source-observation {
    current: source-snapshot,
    previous: option<source-snapshot>,
  }


  variant pull-request-error {
    denied,
    authentication-required,
    unavailable,
    resource-exhausted,
    deadline-exceeded,
  }

  get: func(request: pull-request-request) -> result<source-observation, pull-request-error>;
  bind-snapshot: func(digest: list<u8>) -> result<_, pull-request-error>;
}
