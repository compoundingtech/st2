version 1

// ghost-bug-codex.kdl — the whole eval in one file.  `st2 eval ./` runs it; `st2 up ./` just boots the team.
// The ghost-bug debug loop (labelkit shared-default-mutation bug), run by CODEX seats — proving the
// folder-eval format handles the codex harness. Each fixture workspace intentionally pre-seeds AGENTS.md,
// and bare `ding` asks st2 to render the wake sidecar. Same held-out judges as ghost-bug; all are held-out.

// Harness loaders, personas, and hooks are intentionally baked into fixture workspaces;
// bin/check-harness-contract.sh verifies every current bus-connected model agent.
team "gbx" {                             // prefixes the agents it holds -> gbx.sup, gbx.fix
  agent "sup" {
    workspace "./sup"                    // coordinate-only cwd (owns no product repo)
    env { ST_AGENT "gbx.sup" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then coordinate and verify the whole task end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
  agent "fix" {
    workspace "./worker"                 // owns the labelkit repo (this dir)
    env { ST_AGENT "gbx.fix" }
    command #"exec codex --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --model gpt-5.6-sol -c 'model_reasoning_effort="medium"' 'You just cold-started in a hermetic st2 eval. Read AGENTS.md. Drain the inbox once with st2 message using $ST_ROOT and $ST_AGENT, then set status available; presence is best-effort if this flat eval seat cannot resolve. If the drain contains no work, stand by for DING. After any DING, drain the inbox once again, act on every message, archive each handled item, then execute it end-to-end. Report completion or blockers over the st2 bus.'"#
    ding
  }
}

eval {                                   // `st2 eval` = copy the world, boot the team, kick off, then judge
  copy "./fixture"                       // pre-built starting world, 1:1 (worker/_git -> worker/.git on copy)
  message {                              // kickoff — same as `st2 message send`
    from "requester"
    to "gbx.sup"
    content "./task.md"
  }
  max-timeout "1200s"                    // the whole eval must finish within this

  judges {                               // all must pass; each one visible, nothing magic (all mechanical here)
    judge "isolation — only gbx.fix authored; supervisor owns no repo; change stays in src/test/package/README" {
      exec "bash ./judges/isolation.sh"
    }
    judge "visible suite is green on HEAD" {
      exec "bash ./judges/suite.sh"
    }
    judge "root cause — the shared-default mutation is gone (behavior + no-mutation probes, blind to how)" {
      exec "bash ./judges/root-cause.sh"
    }
    judge "regression test is mutation-valid — RED on the buggy BASE src" {
      exec "bash ./judges/regression.sh"
    }
    judge "coordination — delegate->report visible on the bus" {
      exec "bash ./judges/coordination.sh"
    }
  }
}
