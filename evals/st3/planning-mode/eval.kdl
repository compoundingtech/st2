version 2

subgraph {
  plan "eval/planning-mode" state="ready" {
    completion { when "all-steps-exhausted" }
    goal "Prove one Codex planning session from request through direct approval."
    goal "Keep the proposed plan unpublished until its exact preview is approved."

    step "planning-session" timeout="25m" {
      title "A Codex planner submits one reviewable plan candidate"
      subgraph {
        exec "eval/planning-mode/controller" {
          host "local"
          workspace "${ST_WORKSPACE}"
          cwd "${ST_WORKSPACE}"
          command "bash ./controller.sh"
          restart "never"
          env {
            PLANNED_PLAN "planning-mode-${ST_PLAN_RUN}"
          }
        }
      }
      gate "the controller exits successfully" { field "exit_code" "exec/${ST_PLAN_RUN}/eval/planning-mode/controller" "is" 0 }
    }

    step "gates" timeout="2m" {
      title "The approved planning result keeps every lifecycle boundary"
      depends-on { step "planning-session" completed }
      gate "the planning-mode proof is complete" {
        exec "bash ./verify.sh"
        host "local"
        workspace "${ST_WORKSPACE}"
        time-limit "1m"
      }
    }

  }
}
