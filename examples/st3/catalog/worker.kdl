version 2

  mission "catalog/worker" state="ready" {
    goal "Keep the catalog worker ready for work."
    step "start-worker" {
      agentless
        agent "catalog.worker" {
          workspace "."
          restart "always"
          harness "codex" {
            prompt "Own the assigned repository and wait for graph messages."
          }
        }
      gate "condition-1" { exists "agent/${ST_MISSION_RUN}/catalog.worker" }
    }
  }
