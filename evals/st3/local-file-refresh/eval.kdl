version 2

subgraph {
  resource "local-file-refresh/file" {
    kind "filesystem.file"
  }

  plan "eval/local-file-refresh" state="ready" {
    completion { when "all-steps-exhausted" }
    goal "Refresh one local file observation without exposing its content."

    subgraph {
      observer "file" {
        resource "resource/local-file-refresh/file"
        provider "local.file"
        locator "${ST_WORKSPACE}/watched.txt"
        field "status"
        field "content_hash"
        field "size"
      }
    }

    step "change-and-refresh" timeout="1m" {
      agentless
      title "A manual refresh observes one file change"
      subgraph {
        exec "local-file-refresh/change" {
          host "local"
          workspace "${ST_WORKSPACE}"
          command "bash ./refresh.sh"
          restart "never"
        }
      }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/local-file-refresh/change" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/local-file-refresh/change" "is" 0 }
    }

    step "verify-refresh" timeout="1m" {
      agentless
      depends-on { step "change-and-refresh" completed }
      gate "the refresh completed and kept file content private" {
        exec "bash ./judge.sh"
        host "local"
        workspace "${ST_WORKSPACE}"
        time-limit "1m"
      }
    }
  }
}
