version 2

subgraph {
  scope "eval/weird-git-setup/${PLAN_RUN}" retention="temporary" change-policy="agent" {
    plan "eval/weird-git-setup" state="ready" {
      step "materialize-megarepo" timeout="5m" {
        title "The linked worktree fixture exists"
        subgraph {
          exec "eval/weird-git-setup/materialize/${PLAN_RUN}" {
            host "local"
            workspace "${WORKSPACE}"
            cwd "${WORKSPACE}"
            command "bash ./setup-megarepo.sh"
            restart "never"
            env { CATALOG "${WORKSPACE}" }
          }
        }
        judges {
          field "status" "exec/eval/weird-git-setup/materialize/${PLAN_RUN}" "is" "exited"
          field "exit_code" "exec/eval/weird-git-setup/materialize/${PLAN_RUN}" "is" 0
        }
      }

      step "start-worker" timeout="10m" {
        title "The native Codex worker is ready in the linked worktree"
        depends-on { step "materialize-megarepo" completed }
        subgraph {
          agent "wg.dev" {
            workspace "${WORKSPACE}/wt/feature"
            harness "codex" {
              model "gpt-5.6-sol"
              effort "medium"
              prompt "Read AGENTS.md. Use only st3 message for Small Talk. Never use st, st2, smalltalk, or another message command. st3 sends the assigned parent plan as a message. Drain, read, and archive every st3 message. Follow inherited nested steps through st3 work. After every child step, list assigned work and continue the same parent plan. Use plain CLI output. Do not use --json, request help, poll, or publish routine progress. Send only the required final report. End only after the assigned parent step is completed and no message remains."
              args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
            }
            restart "never"
            env {
              CATALOG "${WORKSPACE}"
              PLAN_RUN "${PLAN_RUN}"
              ST_ROOT "${WORKSPACE}/.st3-messages"
              ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages"
            }
          }
        }
      }

      step "repair-feature-worktree" timeout="20m" {
        title "The worker commits the clamp fix on the feature worktree"
        goal "Resolve the unusual Git checkout. Fix the above-range clamp bug without weakening the existing regression. Keep the full suite green and commit on this checkout's branch."
        assigned-to "agent/wg.dev"
        depends-on { step "start-worker" completed }
        plan "work" {
          step "resolve-checkout" {
            title "The linked worktree context is understood"
            goal "Inspect pwd, git status, git rev-parse --show-toplevel, git rev-parse --git-dir, git branch --show-current, and the .git file. Identify the current branch and shared worktree layout."
          }
          step "reproduce-failure" {
            title "The planted clamp failure is reproduced"
            goal "Run node --test. Read the implementation and existing regression. Identify why an above-range value returns the lower bound."
            depends-on { step "resolve-checkout" completed }
          }
          step "fix-root-cause" {
            title "The above-range branch returns the upper bound"
            goal "Make the smallest source fix. Preserve the existing regression without deletion, skip, or weakening."
            depends-on { step "reproduce-failure" completed }
          }
          step "verify-complete-suite" {
            title "The complete Node suite is green"
            goal "Run node --test. Confirm the above-range regression remains and the worktree diff contains only the intended fix."
            depends-on { step "fix-root-cause" completed }
          }
          step "publish-feature-revision" {
            title "The feature worktree revision is published"
            goal "Commit on the current feature branch with the configured identity. Let SHA be git rev-parse HEAD. Run: st3 claim resource/plan-run/$PLAN_RUN/feature-revision resource.binding --actor agent/wg.dev --field kind=vcs.revision --field state=published --field revision=SHA. Complete this step after the claim."
            depends-on { step "verify-complete-suite" completed }
            produces { resource "plan-run/${PLAN_RUN}/feature-revision" { kind "vcs.revision"; state "published" } }
          }
          step "report-requester" {
            title "The requester receives the verified worktree result"
            goal "Send person/eval-requester exactly one Small Talk message. Include the revision, branch, linked-worktree evidence, and green test command. Use tag plan-run:$PLAN_RUN. Save the bare message ID as MID. Run: st3 claim resource/plan-run/$PLAN_RUN/final-report resource.binding --actor agent/wg.dev --field kind=message.receipt --field state=published --field message=message/$MID. Complete this step after the claim."
            depends-on { step "publish-feature-revision" completed }
            produces { resource "plan-run/${PLAN_RUN}/final-report" { kind "message.receipt"; state "published" } }
          }
        }
      }

      step "held-out-judges" timeout="10m" {
        title "All Weird Git Setup judges pass"
        depends-on { step "repair-feature-worktree" completed }
        judges {
          judge "the checkout is a linked feature worktree" { exec "bash ./judges/worktree-resolved.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}" }; time-limit "120000ms" }
          judge "the complete suite is green" { exec "bash ./judges/suite-green.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}" }; time-limit "120000ms" }
          judge "the fix is committed on feature" { exec "bash ./judges/fix-on-feature.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}" }; time-limit "120000ms" }
          judge "main and the sibling worktree are unchanged" { exec "bash ./judges/no-leak.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}" }; time-limit "120000ms" }
          judge "the seeded regression remains effective" { exec "bash ./judges/regression-test.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}" }; time-limit "120000ms" }
          judge "the graph records the worktree plan, revision, and report" { exec "bash ./judges/graph.sh"; host "local"; workspace "${WORKSPACE}"; env { CATALOG "${WORKSPACE}"; PLAN_RUN "${PLAN_RUN}" }; time-limit "120000ms" }
        }
      }

      step "cleanup" finally=#true {
        title "The temporary eval scope is empty"
        subgraph { scope "eval/weird-git-setup/${PLAN_RUN}" { stop } }
        judges { empty "scope/eval/weird-git-setup/${PLAN_RUN}" }
      }
    }
  }
}
