version 2

subgraph {
  scope "eval/resource-handoff/${ST_PLAN_RUN}" retention="temporary" {
    plan "eval/resource-handoff" state="ready" {
      goal "Complete plan eval/resource-handoff."
      step "contract" timeout="1m" {
        title "The resource moves from A to B without overlap"
        subgraph {
          exec "eval/resource-handoff/contract/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}/fixture"
            cwd "${ST_WORKSPACE}/fixture"
            command "bash ./run.sh"
            restart "never"
          }
        }
        gate "condition-1" { field "status" "exec/eval/resource-handoff/contract/${ST_PLAN_RUN}" "is" "exited" }
        gate "condition-2" { field "exit_code" "exec/eval/resource-handoff/contract/${ST_PLAN_RUN}" "is" 0 }
      }
      step "gate" timeout="1m" {
        depends-on { step "contract" completed }
        gate "the resource history revokes A before granting B" {
          exec "bash ./judge.sh"
          host "local"
          workspace "${ST_WORKSPACE}/fixture"
          time-limit "1m"
        }
      }
      step "cleanup" finally=#true {
        subgraph { scope "eval/resource-handoff/${ST_PLAN_RUN}" { stop } }
        gate "condition" { empty "scope/eval/resource-handoff/${ST_PLAN_RUN}" }
      }
    }
  }
}
