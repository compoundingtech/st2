subgraph {
  checkpoints "eval/ghost-bug-codex" scope="scope/eval/ghost-bug-codex" {
    checkpoint "The eval team is running" {
      subgraph {
        agent "gbx.sup" {
          workspace "${EVAL_ROOT}/sup"
          codex {
            model "gpt-5.6-sol"
            effort "medium"
            prompt "You just cold-started in a hermetic st3 eval. Read AGENTS.md. Drain the inbox once with st3 message using $ST_ROOT and $ST_AGENT, then set status available. If the drain contains no work, stand by for a graph message. After a message arrives, drain the inbox again, act on every message, archive each handled item, and coordinate the whole task end-to-end. Verify the result, then report completion or blockers through st3 messages."
            args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
          }
          restart "never"
          env {
            CATALOG "${EVAL_ROOT}"
            ST_ROOT "${EVAL_ROOT}/.st3-messages"
            ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages"
          }
        }
        agent "gbx.fix" {
          workspace "${EVAL_ROOT}/worker"
          codex {
            model "gpt-5.6-sol"
            effort "medium"
            prompt "You just cold-started in a hermetic st3 eval. Read AGENTS.md. Drain the inbox once with st3 message using $ST_ROOT and $ST_AGENT, then set status available. If the drain contains no work, stand by for a graph message. After a message arrives, drain the inbox again, act on every message, archive each handled item, and execute it end-to-end. Report completion or blockers through st3 messages."
            args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
          }
          restart "never"
          env {
            CATALOG "${EVAL_ROOT}"
            ST_ROOT "${EVAL_ROOT}/.st3-messages"
            ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages"
          }
        }
        message "kickoff" {
          from "requester"
          to "gbx.sup"
          content "doc/evals/ghost-bug-codex/task@25c585de3c879e9f4a215ddda598409689bd4dd8340eacb5ff278f9e61663589"
        }
      }
      judges {
        exists "agent/gbx.sup"
        exists "agent/gbx.fix"
        deadline "1200000ms"
      }
    }
    checkpoint "The team reported completion" {
      judges {
        judge "The worker reported before the supervisor confirmed" {
          exec "TIMEOUT_SECONDS=1200 bash ./.st3-migration/wait-team-done.sh requester gbx.sup kickoff gbx.fix"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1205000ms"
        }
      }
    }
    checkpoint "All held-out judges pass" {
      judges {
        judge "isolation — only gbx.fix authored; supervisor owns no repo; change stays in src/test/package/README" {
          exec "st3 message export \"${EVAL_ROOT}/.st3-messages\" >/dev/null && bash ./judges/isolation.sh"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "visible suite is green on HEAD" {
          exec "st3 message export \"${EVAL_ROOT}/.st3-messages\" >/dev/null && bash ./judges/suite.sh"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "root cause — the shared-default mutation is gone (behavior + no-mutation probes, blind to how)" {
          exec "st3 message export \"${EVAL_ROOT}/.st3-messages\" >/dev/null && bash ./judges/root-cause.sh"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "regression test is mutation-valid — RED on the buggy BASE src" {
          exec "st3 message export \"${EVAL_ROOT}/.st3-messages\" >/dev/null && bash ./judges/regression.sh"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "coordination — delegate->report visible on the bus" {
          exec "st3 message export \"${EVAL_ROOT}/.st3-messages\" >/dev/null && bash ./judges/coordination.sh"
          host "local"
          workspace "${EVAL_ROOT}"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "the report explains the root cause and the regression proof" type="llm" {
          model "gpt-5.6-sol"
          host "local"
          workspace "${EVAL_ROOT}"
          tools "shell" "git"
          env { CATALOG "${EVAL_ROOT}"; ST_ROOT "${EVAL_ROOT}/.st3-messages"; ST3_MESSAGE_ROOT "${EVAL_ROOT}/.st3-messages" }
          token-budget 65536
          time-limit "120000ms"
          prompt "Run one evidence command before judgement: show the worker HEAD diff for src and test files, show git -C worker status --porcelain, and print .st3-messages/requester/inbox/* plus .st3-messages/requester/archive/*. Do not run st3 agents, st3 status, help commands, or broad scans. PASS only if the change fixes the shared-default mutation at its root, adds a real regression test, creates a commit with a clean tree, and the supervisor reports this evidence."
        }
        deadline "1200000ms"
      }
    }
    checkpoint "The temporary eval scope is empty" {
      subgraph {
        scope "eval/ghost-bug-codex" { stop }
      }
      judges { empty "scope/eval/ghost-bug-codex" }
    }
  }
}
