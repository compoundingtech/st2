subgraph {
  agent "native.claude" {
    workspace "."
    claude {
      dev-channels #true
      prompt "Wait for a native graph message."
    }
  }

  agent "native.codex" {
    workspace "."
    codex {
      prompt "Wait for a native graph message."
    }
  }

  agent "native.pi" {
    workspace "."
    pi {
      prompt "Wait for a native graph message."
    }
  }

  agent "native.opencode" {
    workspace "."
    opencode {
      prompt "Wait for a native graph message."
    }
  }
}
