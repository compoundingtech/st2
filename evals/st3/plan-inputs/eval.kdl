version 2

subgraph {
  resource "plan-inputs/source" {
    kind "document"
    binding "late"
  }

  plan "eval/plan-inputs" state="ready" {
    input "message" kind="text"
    input "source" kind="resource"
    completion { when "all-steps-exhausted" }
    goal "Preserve one text input and one exact resource input."

    step "capture-inputs" timeout="1m" {
      agentless
      title "The plan run captures both input kinds"
      subgraph {
        exec "eval/plan-inputs/capture" {
          host "local"
          workspace "${ST_WORKSPACE}"
          cwd "${ST_WORKSPACE}"
          command "bash ./capture.sh"
          env {
            MESSAGE "${input.message}"
            SOURCE "${input.source}"
          }
          restart "never"
        }
      }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/eval/plan-inputs/capture" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/eval/plan-inputs/capture" "is" 0 }
    }

    step "verify-inputs" timeout="1m" {
      agentless
      depends-on { step "capture-inputs" completed }
      gate "the text and exact resource version survive execution" {
        exec "bash ./judge.sh"
        host "local"
        workspace "${ST_WORKSPACE}"
        env {
          EXPECTED_MESSAGE "${input.message}"
          EXPECTED_SOURCE "${input.source}"
        }
        time-limit "1m"
      }
    }
  }
}
