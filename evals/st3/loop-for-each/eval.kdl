version 2

resource "eval/loop-for-each/items" { kind "custom.eval.loop-items" }

mission "eval/loop-for-each" state="ready" timeout="20m" {
  completion { when "all-steps-exhausted" }
  goal "Run one bounded child mission for each item in a stable resource snapshot."

  step "seed" timeout="1m" {
    agentless
    exec "seed-items" {
      host "local"
      workspace "${ST_WORKSPACE}"
      command "bash ./seed.sh"
      restart "never"
    }
    gate "the item resource is ready" {
      field "exit_code" "exec/${ST_MISSION_RUN}/seed-items" "is" 0
    }
  }

  loop "items" for-each="resource/eval/loop-for-each/items" field="items" max-parallel=2 {
    max-rounds 5
    depends-on { step "seed" completed }
    round {
      completion { when "all-steps-exhausted" }
      step "capture" {
        agentless
        exec "capture-item" {
          host "local"
          workspace "${ST_WORKSPACE}"
          command "bash ./capture-item.sh"
          restart "never"
        }
        gate "the item was captured" {
          field "exit_code" "exec/${ST_MISSION_RUN}/capture-item" "is" 0
        }
      }
    }
  }

  step "verify" timeout="1m" {
    agentless
    depends-on { step "items" completed }
    gate "every item child used its automatic context" {
      exec "test -f item-one.txt && test -f item-two.txt && test -f item-three.txt"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "30s"
    }
  }
}
