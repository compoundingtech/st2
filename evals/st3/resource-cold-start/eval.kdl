version 2

subgraph {
  scope "eval/resource-cold-start/${ST_PLAN_RUN}" retention="temporary" {
    plan "eval/resource-cold-start" state="ready" {
      goal "Complete plan eval/resource-cold-start."
      step "contract" timeout="1m" {
        title "The cold resource becomes ready before delivery"
        subgraph {
          exec "eval/resource-cold-start/contract/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}/fixture"
            cwd "${ST_WORKSPACE}/fixture"
            command "bash ./run.sh"
            restart "never"

          }
        }
        gate "condition-1" { field "status" "exec/eval/resource-cold-start/contract/${ST_PLAN_RUN}" "is" "exited" }
        gate "condition-2" { field "exit_code" "exec/eval/resource-cold-start/contract/${ST_PLAN_RUN}" "is" 0 }
      }

      step "gate" timeout="1m" {
        title "The cold-start transition is valid"
        depends-on { step "contract" completed }
        gate "the resource claim precedes one Small Talk action" {
          exec "bash ./judge.sh"
          host "local"
          workspace "${ST_WORKSPACE}/fixture"

          time-limit "1m"
        }
      }

      step "cleanup" finally=#true {
        title "The temporary eval scope is empty"
        subgraph { scope "eval/resource-cold-start/${ST_PLAN_RUN}" { stop } }
        gate "condition" { empty "scope/eval/resource-cold-start/${ST_PLAN_RUN}" }
      }
    }
  }
}
