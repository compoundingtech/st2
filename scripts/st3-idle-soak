#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

: "${ST3_BIN:?set ST3_BIN to the local installed st3 executable}"
: "${FABRIC_BIN:?set FABRIC_BIN to the installed Fabric executable}"
: "${ST3_SOAK_SILBER_BIN:?set ST3_SOAK_SILBER_BIN to the remote installed st3 executable}"
JQ_BIN=${ST3_SOAK_JQ_BIN:-$(command -v jq)}
STATE_DIR=${ST3_SOAK_IDLE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/st3/idle-soak}
LOCAL_SAMPLE="$(/usr/bin/dirname "$ST3_BIN")/st3-idle-sample"
REMOTE_SAMPLE="$(/usr/bin/dirname "$ST3_SOAK_SILBER_BIN")/st3-idle-sample"
/usr/bin/mkdir -p "$STATE_DIR"

record() {
  local host=$1 result
  if [[ $host == hetz ]]; then
    if result=$(ST3_BIN="$ST3_BIN" ST3_SOAK_HOST=hetz "$LOCAL_SAMPLE" 2>/dev/null) &&
      "$JQ_BIN" -e '.host == "hetz" and .peer_status == "up"' <<<"$result" >/dev/null; then
      /usr/bin/printf '%s\n' "$result" >>"$STATE_DIR/events.jsonl"
      return
    fi
  elif result=$("$FABRIC_BIN" exec silber -- /usr/bin/env \
    "ST3_BIN=$ST3_SOAK_SILBER_BIN" ST3_SOAK_HOST=silber "$REMOTE_SAMPLE" 2>/dev/null) &&
    "$JQ_BIN" -e '.host == "silber" and .peer_status == "up"' <<<"$result" >/dev/null; then
    /usr/bin/printf '%s\n' "$result" >>"$STATE_DIR/events.jsonl"
    return
  fi
  "$JQ_BIN" -nc --arg host "$host" --argjson at "$(/bin/date -u +%s)" \
    '{at:$at,host:$host,error:"sample-or-peer-failed"}' >>"$STATE_DIR/events.jsonl"
}

while true; do
  record hetz
  record silber
  [[ ${1:-} == --once ]] && exit 0
  /usr/bin/sleep 60
done
