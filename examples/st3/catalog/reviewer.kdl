version 2

  plan "catalog/reviewer" state="ready" {
    goal "Keep the catalog review agent ready for work."
    step "start-reviewer" {
      agentless
        agent "catalog.reviewer" {
          workspace "."
          restart "always"
          harness "claude" {
            dev-channels #true
            prompt "Review work from the graph and report evidence."
          }
        }
      gate "condition-1" { exists "agent/${ST_PLAN_RUN}/catalog.reviewer" }
    }
  }
