version 2

  resource "st3-stabilization-review" {
    kind "human.review"
  }

  plan "stabilize-st3" state="ready" {

    completion { when "all-steps-exhausted" }
    goal "Complete plan stabilize-st3."
    step "free-verification" timeout="30m" {
      title "The deterministic st3 verification passes"
        exec "stabilize-st3/free-verification" {
          workspace "."
          command "cargo test -q -p st3 && cargo test -q -p st3-migrate && cargo clippy -p st3 -p st3-migrate --no-deps -- -D warnings && cargo fmt --all -- --check"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/stabilize-st3/free-verification" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/stabilize-st3/free-verification" "is" 0 }
    }

    step "migration-audit" timeout="5m" {
      title "The migration audit records every opaque provider command"
      depends-on { step "free-verification" completed }
        exec "stabilize-st3/migration-audit" {
          workspace "."
          command "test -f docs/st3/stabilization-report.md && rg 'Opaque Codex evals: 16|Opaque Claude evals: 26' docs/st3/stabilization-report.md"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/stabilize-st3/migration-audit" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/stabilize-st3/migration-audit" "is" 0 }
    }

    step "license-mit" timeout="25m" {
      title "The license MIT Claude eval passes"
      depends-on { step "migration-audit" completed }
        exec "stabilize-st3/license-mit" {
          workspace "."
          command "st3 eval ./evals/st3/license-mit"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/stabilize-st3/license-mit" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/stabilize-st3/license-mit" "is" 0 }
    }

    step "ghost-bug-codex" timeout="25m" {
      title "The ghost bug Codex eval passes"
      depends-on { step "license-mit" completed }
        exec "stabilize-st3/ghost-bug-codex" {
          workspace "."
          command "st3 eval ./evals/st3/ghost-bug"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/stabilize-st3/ghost-bug-codex" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/stabilize-st3/ghost-bug-codex" "is" 0 }
    }

    step "signal-rename-codex" timeout="35m" {
      title "The signal rename Codex eval passes"
      depends-on { step "ghost-bug-codex" completed }
        exec "stabilize-st3/signal-rename-codex" {
          workspace "."
          command "st3 eval ./evals/st3/signal-rename"
          restart "never"
        }
      gate "condition-1" { field "status" "exec/${ST_PLAN_RUN}/stabilize-st3/signal-rename-codex" "is" "exited" }
      gate "condition-2" { field "exit_code" "exec/${ST_PLAN_RUN}/stabilize-st3/signal-rename-codex" "is" 0 }
    }

    step "review" {
      title "A person reviews the stabilization receipts"
      depends-on { step "signal-rename-codex" completed }
      gate "condition-1" { field "decision" "resource/st3-stabilization-review" "is" "approved" }
    }
  }
