version 2

subgraph {
  scope "eval/pty-attach-only/${ST_PLAN_RUN}" retention="temporary" change-policy="agent" {
    plan "eval/pty-attach-only" state="ready" {
      goal "Complete plan eval/pty-attach-only."
      step "contract" timeout="2m" {
        title "Attach-only never restarts a dead PTY session"
        subgraph {
          exec "eval/pty-attach-only/probe/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}/fixture"
            cwd "${ST_WORKSPACE}/fixture"
            command "bash -o pipefail -c 'bash ./probe.sh | tee proof.txt'"
            restart "never"
            env { CATALOG "${ST_WORKSPACE}/fixture" }
          }
        }
        gate "condition-1" { field "status" "exec/eval/pty-attach-only/probe/${ST_PLAN_RUN}" "is" "exited" }
        gate "condition-2" { field "exit_code" "exec/eval/pty-attach-only/probe/${ST_PLAN_RUN}" "is" 0 }
      }
      step "gate" timeout="1m" {
        depends-on { step "contract" completed }
        gate "all attach-only markers are present" {
          exec "bash ./judge.sh"
          host "local"
          workspace "${ST_WORKSPACE}/fixture"
        }
      }
      step "cleanup" finally=#true {
        subgraph { scope "eval/pty-attach-only/${ST_PLAN_RUN}" { stop } }
        gate "condition" { empty "scope/eval/pty-attach-only/${ST_PLAN_RUN}" }
      }
    }
  }
}
