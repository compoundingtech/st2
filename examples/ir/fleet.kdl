// Example IR — the human-authored input to `st2 render`. One `agent` per node, high-level:
// role / harness / model / persona / workspace (+ an optional permissions block). `st2 render` lowers
// this to a runnable catalog (agent.kdl + the workspace overlay) with wiring identical to convoy.
//
// Edit `workspace` to a real repo you want the agent to run in, then:
//   st2 render examples/ir /tmp/mycatalog
//   st2 ls   /tmp/mycatalog          # the runner sees a runnable agent
//   st2 up   /tmp/mycatalog          # supervise: it boots (exec claude) + talks on the bus

agent "demo-worker-claude" {
  host      "demo"
  role      "worker"
  harness   "claude"
  model     "opus"
  persona   "worker"
  workspace "/replace/with/a/real/repo/path"
  supervisor "demo-cos-claude"

  // Optional: restrict which tools this agent may call (blocks without prompting; never hangs).
  permissions {
    tools { deny "WebSearch" }   // e.g. no web search for this agent
    spawn #false                 // and it may not spawn subagents
  }
}
