version 2

subgraph {
  scope "eval/crash-escalation/${PLAN_RUN}" retention="temporary" change-policy="agent" {
    plan "eval/crash-escalation" state="ready" {
      step "faults" timeout="1m" {
        title "The runtime classifies abnormal and clean exits"
        subgraph {
          exec "eval/crash-escalation/crash/${PLAN_RUN}" {
            host "local"
            workspace "${WORKSPACE}"
            command "exit 17"
            restart "always"
            restart { attempts 1; interval "60s"; mode "fail" }
          }
          exec "eval/crash-escalation/clean/${PLAN_RUN}" {
            host "local"
            workspace "${WORKSPACE}"
            command "exit 0"
            restart "never"
          }
        }
        judges {
          field "reachability" "exec/eval/crash-escalation/crash/${PLAN_RUN}" "is" "unreachable"
          field "exit_code" "exec/eval/crash-escalation/crash/${PLAN_RUN}" "is" 17
          field "status" "exec/eval/crash-escalation/clean/${PLAN_RUN}" "is" "exited"
          field "exit_code" "exec/eval/crash-escalation/clean/${PLAN_RUN}" "is" 0
        }
      }
      step "judge" timeout="1m" {
        depends-on { step "faults" completed }
        judges {
          judge "only the abnormal exit has a raised supervision decision" {
            exec "bash ./judge.sh"
            host "local"
            workspace "${WORKSPACE}/fixture"
            env { PLAN_RUN "${PLAN_RUN}" }
            time-limit "1m"
          }
        }
      }
      step "cleanup" finally=#true {
        subgraph { scope "eval/crash-escalation/${PLAN_RUN}" { stop } }
        judges { empty "scope/eval/crash-escalation/${PLAN_RUN}" }
      }
    }
  }
}
