version 2

subgraph {
  scope "eval/license-mit-codex/${PLAN_RUN}" retention="temporary" change-policy="agent" {
    plan "eval/license-mit-codex" state="ready" {
    step "team" timeout="1200000ms" {
      title "The eval team is running"
      subgraph {
        agent "lmc.sup" {
          workspace "${WORKSPACE}/sup"
          harness "codex" {
            model "gpt-5.6-sol"
            effort "medium"
            prompt "You just cold-started in a hermetic st3 eval. Read AGENTS.md. Drain the inbox once with st3 message using $ST_ROOT and $ST_AGENT, then set status available. If the drain contains no work, end this turn and stay idle. Do not run a blocking wait, trace, poll, or sleep command. The native driver will start a new turn when a message arrives. Then drain the inbox again, act on every message, archive each handled item, and coordinate the whole task end-to-end. Report completion or blockers through st3 messages."
            args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
          }
          restart "never"
          env {
            CATALOG "${WORKSPACE}"
            ST_ROOT "${WORKSPACE}/.st3-messages"
            ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages"
          }
        }
        agent "lmc.worker" {
          workspace "${WORKSPACE}/worker"
          harness "codex" {
            model "gpt-5.6-sol"
            effort "medium"
            prompt "You just cold-started in a hermetic st3 eval. Read AGENTS.md. Drain the inbox once with st3 message using $ST_ROOT and $ST_AGENT, then set status available. If the drain contains no work, end this turn and stay idle. Do not run a blocking wait, trace, poll, or sleep command. The native driver will start a new turn when a message arrives. Then drain the inbox again, act on every message, archive each handled item, and execute it end-to-end. Report completion or blockers through st3 messages."
            args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
          }
          restart "never"
          env {
            CATALOG "${WORKSPACE}"
            ST_ROOT "${WORKSPACE}/.st3-messages"
            ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages"
          }
        }
        message "kickoff/${PLAN_RUN}" {
          from "requester"
          to "lmc.sup"
          content "doc/evals/license-mit-codex/task@7ebefe1e115dbfb438ca4da438b3b9d825dcd2cced572393235c70ac070a5e21"
        }
      }
      judges {
        exists "agent/lmc.sup"
        exists "agent/lmc.worker"
      }
    }
    step "team-completion" timeout="1205000ms" {
      title "The team reported completion"
      depends-on { step "team" completed }
      judges {
        judge "The worker reported before the supervisor confirmed" {
          exec "TIMEOUT_SECONDS=1200 bash ./.st3-migration/wait-team-done.sh requester lmc.sup kickoff/${PLAN_RUN} lmc.worker"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1205000ms"
        }
      }
    }
    step "held-out-judges" timeout="1200000ms" {
      title "All held-out judges pass"
      depends-on { step "team-completion" completed }
      judges {
        judge "isolation — supervisor owns no repo; change stays on the license surface" {
          exec "st3 message export \"${WORKSPACE}/.st3-messages\" >/dev/null && bash ./judges/isolation.sh"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "coordination — delegate->report->verified-confirm visible on the bus" {
          exec "st3 message export \"${WORKSPACE}/.st3-messages\" >/dev/null && bash ./judges/coordination.sh"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "LICENSE is real MIT" {
          exec "st3 message export \"${WORKSPACE}/.st3-messages\" >/dev/null && set -eu; grep -F -- 'Permission is hereby granted, free of charge' 'worker/LICENSE' >/dev/null; grep -F -- 'THE SOFTWARE IS PROVIDED \"AS IS\"' 'worker/LICENSE' >/dev/null; ! grep -F -- 'proprietary' 'worker/LICENSE' >/dev/null"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "package.json declares MIT" {
          exec "st3 message export \"${WORKSPACE}/.st3-messages\" >/dev/null && set -eu; test \"$(jq -c '.license' 'worker/package.json')\" = '\"MIT\"'"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "the change is committed + the worktree is clean" {
          exec "st3 message export \"${WORKSPACE}/.st3-messages\" >/dev/null && bash ./judges/committed.sh"
          host "local"
          workspace "${WORKSPACE}"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          time-limit "1200000ms"
        }
        judge "confirmation is verified, not a rubber-stamp" type="llm" {
          model "gpt-5.6-sol"
          host "local"
          workspace "${WORKSPACE}"
          tools "shell" "git"
          env { CATALOG "${WORKSPACE}"; ST_ROOT "${WORKSPACE}/.st3-messages"; ST3_MESSAGE_ROOT "${WORKSPACE}/.st3-messages" }
          token-budget 65536
          time-limit "120000ms"
          prompt "Run one evidence command before judgement: print .st3-messages/requester/inbox/* and .st3-messages/requester/archive/*, then run git -C worker rev-parse HEAD and git -C worker status --porcelain. Do not run st3 agents, st3 status, help commands, or broad scans. PASS if the supervisor confirmation cites the real commit and verifies the MIT license, committed HEAD, and clean tree. FAIL if it gives no evidence."
        }
      }
    }
    step "cleanup" finally=#true {
      title "The temporary eval scope is empty"
      subgraph {
        scope "eval/license-mit-codex/${PLAN_RUN}" { stop }
      }
      judges { empty "scope/eval/license-mit-codex/${PLAN_RUN}" }
    }
    }
  }
}
