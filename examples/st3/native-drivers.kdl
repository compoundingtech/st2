subgraph {
  agent "native.claude" {
    workspace "."
    harness "claude" {
      dev-channels #true
      prompt "Wait for a native graph message."
    }
  }

  agent "native.codex" {
    workspace "."
    harness "codex" {
      prompt "Wait for a native graph message."
    }
  }

  agent "native.pi" {
    workspace "."
    harness "pi" {
      prompt "Wait for a native graph message."
    }
  }

  agent "native.opencode" {
    workspace "."
    harness "opencode" {
      prompt "Wait for a native graph message."
    }
  }
}
