version 2

subgraph {
  scope "eval/run-generation-revision/${ST_PLAN_RUN}" retention="temporary" {
    plan "eval/run-generation-revision" state="ready" {
      goal "Prove an approved plan revision creates one immutable successor generation."
      goal "Prove compatible state and automatic run environment move to the successor."

      step "exercise-revision" timeout="5m" {
        title "The controller revises one live plan run"
        subgraph {
          exec "eval/run-generation-revision/controller/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}"
            cwd "${ST_WORKSPACE}"
            command "bash ./controller.sh"
            restart "never"
          }
        }
        gate "the revision controller exits successfully" { field "exit_code" "exec/eval/run-generation-revision/controller/${ST_PLAN_RUN}" "is" 0 }
      }

      step "verify" timeout="2m" {
        title "The generation record has the required lineage and state"
        depends-on { step "exercise-revision" completed }
        gate "the generation proof is complete" {
          exec "bash ./verify.sh"
          host "local"
          workspace "${ST_WORKSPACE}"
          time-limit "1m"
        }
      }

      step "cleanup" finally=#true {
        title "The temporary eval scope is empty"
        subgraph { scope "eval/run-generation-revision/${ST_PLAN_RUN}" { stop } }
        gate "the eval scope has no live member" { empty "scope/eval/run-generation-revision/${ST_PLAN_RUN}" }
      }
    }
  }
}
