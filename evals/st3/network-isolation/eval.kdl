version 2

subgraph {
  scope "eval/network-isolation/${ST_PLAN_RUN}" retention="temporary" change-policy="agent" {
    plan "eval/network-isolation" state="ready" {
      goal "Complete plan eval/network-isolation."
      step "contract" timeout="2m" {
        title "Two nested st3 networks remain isolated"
        subgraph {
          exec "eval/network-isolation/contract/${ST_PLAN_RUN}" {
            host "local"
            workspace "${ST_WORKSPACE}/fixture"
            cwd "${ST_WORKSPACE}/fixture"
            command "bash ./run.sh"
            restart "never"
          }
        }
        gate "condition-1" { field "status" "exec/eval/network-isolation/contract/${ST_PLAN_RUN}" "is" "exited" }
        gate "condition-2" { field "exit_code" "exec/eval/network-isolation/contract/${ST_PLAN_RUN}" "is" 0 }
      }
      step "gate" timeout="1m" {
        depends-on { step "contract" completed }
        gate "both endpoint and state partitions hold" {
          exec "grep -Fq NETWORK-A-ISOLATED result.txt && grep -Fq NETWORK-B-ISOLATED result.txt"
          host "local"
          workspace "${ST_WORKSPACE}/fixture"
        }
      }
      step "cleanup" finally=#true {
        subgraph { scope "eval/network-isolation/${ST_PLAN_RUN}" { stop } }
        gate "condition" { empty "scope/eval/network-isolation/${ST_PLAN_RUN}" }
      }
    }
  }
}
